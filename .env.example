# Variáveis na Vercel (Settings → Environment Variables) — NÃO commitar valores reais

# Chave da API Resend (começa por re_)
RESEND_API_KEY=

# Remetente: com domínio verificado no Resend, ex. contato@seudominio.com
# Em testes na Resend pode usar onboarding@resend.dev (só para e-mail da conta)
RESEND_FROM_EMAIL=onboarding@resend.dev

# Quem recebe cada ficha (ex.: e-mail da profissional — não precisa ser o mesmo da conta Resend)
# Vários destinatários: separar por vírgula, ex.: amanda@email.com, teuemail@gmail.com
ANAMNESE_TO_EMAIL=

# Opcional — só para desenvolvimento local apontar ao deploy:
# URL completa do endpoint, ex. https://teu-proj.vercel.app/api/anamnese
# VITE_ANAMNESE_API_URL=

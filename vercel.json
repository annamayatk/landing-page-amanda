{
  "crons": [
    {
      "path": "/api/cron/payment-reminders",
      "schedule": "0 12 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/ficha-inicial",
      "destination": "/ficha-inicial.html"
    },
    {
      "source": "/ficha-inicial/",
      "destination": "/ficha-inicial.html"
    },
    {
      "source": "/((?!api/|src/|node_modules/|assets/|@).*)",
      "destination": "/index.html"
    }
  ]
}
